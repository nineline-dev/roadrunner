{
  "name": "@gcs/analytics",
  "version": "1.0.0",
  "description": "Unified analytics package for GCS - PostHog, GA4, RudderStack integration",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@rudderstack/analytics-js": "^3.31.2",
    "posthog-js": "^1.379.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.16",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^30.4.2",
    "react": "19.2.7",
    "tsup": "^8.0.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
